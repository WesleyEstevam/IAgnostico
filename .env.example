# Firebase Web App (Firebase Console > Configurações do projeto > Seus apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Firebase Console > Contas de serviço)
# Mantenha a chave privada em uma única linha, usando \\n para as quebras.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# IA do paciente (somente no servidor)
AI_PROVIDER=openai
AI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
GEMINI_API_KEY=

# URLs públicas usadas por integrações, links de e-mail e webhooks
APP_URL=https://iagnostico.com.br
ADMIN_URL=https://adm.iagnostico.com.br
